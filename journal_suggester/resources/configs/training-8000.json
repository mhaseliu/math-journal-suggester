{
  "training_papers": 8000,
  "validation_papers": 1000,
  "minimum_training_per_journal": 0,
  "sampling": "publication-count proportional, redistributing shortages within the audited reference pool",
  "seed": 42,
  "learning_rate": 0.00004,
  "epochs": 5,
  "batch": 1,
  "accum": 8,
  "candidate_k": 20,
  "candidate_order": "retrieval",
  "max_state": 5504,
  "max_request": 6144,
  "precision": "strict_fast",
  "validation_every_steps": 500,
  "early_stopping": {
    "minimum_epochs": 2,
    "patience": 3,
    "loss_min_delta": 0.01,
    "reset_patience_on_new_top3_best": true,
    "loss_scope": "fixed natural-candidate validation subset, 845 papers"
  },
  "checkpoint_selection": "highest validation top3, earlier checkpoint on ties",
  "test_scored": false
}
